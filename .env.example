# Copy to ".env" for local development, or set these as real environment
# variables in whatever process manager runs eyv_poller in production.
# Never put the bearer token itself in this file or in ".env" — that is
# stored separately via `python -m eyv_poller.auth`, see README.md.

# EYV's Railway deployment base URL (required, no default).
EYV_BASE_URL=https://your-eyv-app.up.railway.app

# --- OPEN DECISION — see README.md "Polling interval" ---------------------
# No default is provided on purpose: this value has not been confirmed.
# Uncomment and set explicitly once a decision is made. A minute or two
# has been suggested as a plausible starting point for manual local
# testing only — not a production recommendation.
# EYV_POLL_INTERVAL_SEC=90

# --- Optional overrides (all have sane defaults) ---------------------------
# EYV_QUEUE_PATH=/jarvis/queue
# EYV_TOKEN_PATH=/home/you/.jarvis/eyv_poller/queue_token.txt
# EYV_REQUEST_TIMEOUT_SEC=10
# EYV_MAX_RETRIES=3
# EYV_RETRY_BACKOFF_BASE_SEC=1.5
# EYV_LOG_DIR=/home/you/.jarvis/eyv_poller/logs
# EYV_LOG_LEVEL=INFO

# =============================================================================
# jarvis_core (B.2 — JARVIS Reasoning Core) — see README.md's B.2 section.
# Reuses the EYV_* settings above for queue polling and the /jarvis/decisions
# bearer token; everything below is B.2-specific.
# =============================================================================

# Required — the Claude API key used for reasoning (B.2.1). Never commit this.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional overrides (all have sane defaults) ---------------------------
# JARVIS_ARCHITECTURE_DOC_PATH=/path/to/docs/jarvis_architecture.md
# JARVIS_CLAUDE_MODEL=claude-opus-5
# JARVIS_CLAUDE_MAX_TOKENS=4096
# JARVIS_CONFIDENCE_THRESHOLD=0.7
# JARVIS_DB_PATH=/home/you/.jarvis/jarvis_core/jarvis.db
# JARVIS_DECISIONS_PATH=/jarvis/decisions
# JARVIS_REQUEST_TIMEOUT_SEC=10
# JARVIS_MAX_RETRIES=3
# JARVIS_RETRY_BACKOFF_BASE_SEC=1.5
# JARVIS_LOG_DIR=/home/you/.jarvis/jarvis_core/logs
# JARVIS_LOG_LEVEL=INFO

# =============================================================================
# jarvis_core/voice/ (voice + UI layer) — see README.md's Voice section.
# Reuses ANTHROPIC_API_KEY above and JARVIS_DB_PATH (a separate
# `voice_turns` table in the same file). The ElevenLabs key itself is
# NOT set here — it's stored via `python -m jarvis_core.voice.auth set`,
# same 0600-local-file convention as the EYV queue token.
# =============================================================================

# --- Optional overrides (all have sane defaults) ---------------------------
# JARVIS_VOICE_CLAUDE_MODEL=claude-opus-5
# JARVIS_VOICE_CLAUDE_MAX_TOKENS=1024
# JARVIS_VOICE_CLAUDE_EFFORT=low
# JARVIS_VOICE_WHISPER_MODEL=base
# JARVIS_VOICE_WHISPER_DEVICE=cpu
# JARVIS_VOICE_WHISPER_COMPUTE_TYPE=int8
# JARVIS_VOICE_MIN_UTTERANCE_SEC=0.4
# JARVIS_VOICE_NO_SPEECH_PROB_THRESHOLD=0.6
# JARVIS_VOICE_SAMPLE_RATE=16000
# JARVIS_VOICE_ELEVENLABS_KEY_PATH=/home/you/.jarvis/jarvis_core/voice/elevenlabs_key.txt
# JARVIS_VOICE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# JARVIS_VOICE_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# JARVIS_VOICE_ELEVENLABS_OUTPUT_FORMAT=pcm_16000
# JARVIS_VOICE_REQUEST_TIMEOUT_SEC=15
# JARVIS_VOICE_MAX_RETRIES=3
# JARVIS_VOICE_RETRY_BACKOFF_BASE_SEC=1.5
